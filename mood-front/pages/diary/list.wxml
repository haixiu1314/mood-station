<view class="container mood-page mood-diary-list">
  <view class="screen-heading"><text class="screen-title">我的心情手记</text><text class="screen-subtitle">把走过的日子，轻轻收好。</text></view>
  <!-- 顶部搜索和回收站 -->
  <view class="header-bar">
    <view class="search-bar">
      <image class="search-icon ui-icon" src="/images/healing/search.png" mode="aspectFit"></image>
      <input class="search-input" placeholder="搜索日记标题或内容" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="onSearch"  placeholder-style="color: #68756A;" />
      <text class="search-btn" wx:if="{{searchKeyword}}" bindtap="onSearch" hover-class="mood-pressed" hover-start-time="20" hover-stay-time="90">搜索</text>
    </view>
    <view class="trash-btn" bindtap="onGoTrash" hover-class="mood-pressed" hover-start-time="20" hover-stay-time="90">
      <image class="trash-icon" src="/images/healing/trash.png" mode="aspectFit"></image>
    </view>
  </view>

  <!-- 日期筛选 -->
  <view class="filter-bar">
    <picker mode="date" value="{{filterDate}}" start="2020-01-01" end="2030-12-31" bindchange="onDateChange">
      <view class="filter-btn {{filterDate ? 'active' : ''}}">
        <image class="filter-icon ui-icon" src="/images/healing/calendar.png" mode="aspectFit"></image>
        <text class="filter-text">{{filterDate || '按日期筛选'}}</text>
      </view>
    </picker>
    <view class="filter-reset" wx:if="{{filterDate}}" bindtap="onResetFilter" hover-class="mood-pressed" hover-start-time="20" hover-stay-time="90">
      <text>重置</text>
    </view>
  </view>

  <!-- 日记列表 -->
  <view class="diary-list" wx:if="{{diaries.length > 0}}">
    <view class="diary-card" wx:for="{{diaries}}" wx:key="id" bindtap="onDiaryTap" data-id="{{item.id}}" hover-class="mood-pressed" hover-start-time="20" hover-stay-time="90">
      <view class="diary-header">
        <view class="emotion-tag emotion-{{item.emotion}}" style="background-color: {{emotionMap[item.emotion].bg}}; color: {{emotionMap[item.emotion].color}}">
          <image class="emotion-icon" src="/images/healing/mood-{{item.emotion}}.png" mode="aspectFit"></image>
          {{emotionMap[item.emotion].label}}
        </view>
        <text class="diary-time">{{item.createTime}}</text>
      </view>
      <view class="diary-title" wx:if="{{item.title}}">{{item.title}}</view>
      <view class="diary-content">{{item.content}}</view>
      <view class="diary-footer">
        <view class="delete-btn" catchtap="onDeleteDiary" data-id="{{item.id}}" hover-class="mood-pressed" hover-start-time="20" hover-stay-time="90">
          <text>删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <image class="empty-icon" src="/images/healing/leaf.png" mode="aspectFit"></image>
    <text class="empty-text">{{emptyText || '还没有日记，快去写一篇吧~'}}</text>
  </view>
</view>
