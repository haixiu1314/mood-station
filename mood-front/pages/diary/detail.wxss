@import "../../styles/healing.wxss";
.container {
  padding: 32rpx;
  padding-bottom: 120rpx;
  background-color: var(--mood-paper);
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.emotion-tag {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 32rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.emotion-icon {
  margin-right: 6rpx;
  font-size: 32rpx;
}

.emotion-tag.happy {
  background-color: var(--mood-honey-soft);
  color: var(--mood-honey);
}

.emotion-tag.sad {
  background-color: var(--mood-blue-soft);
  color: var(--mood-blue);
}

.emotion-tag.angry {
  background-color: var(--mood-rose-soft);
  color: var(--mood-rose);
}

.emotion-tag.calm {
  background-color: var(--mood-sage-soft);
  color: var(--mood-sage-ink);
}

.time {
  font-size: 24rpx;
  color: var(--mood-faint);
}

/* 标题 */
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--mood-ink);
  margin-bottom: 32rpx;
  line-height: 1.4;
}

/* 内容卡片 */
.content {
  font-size: 30rpx;
  color: var(--mood-ink);
  line-height: 1.8;
  background-color: var(--mood-surface);
  padding: 40rpx 32rpx;
  border-radius: 32rpx;
  
  margin-bottom: 48rpx;
}

/* 操作按钮 */
.actions {
  display: flex;
  gap: 24rpx;
}

.actions button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 96rpx;
  height: 96rpx;
  font-size: 28rpx;
}

.btn-edit {
  background: var(--mood-sage-soft);
  color: var(--mood-sage-ink);
  border-radius: 48rpx;
  font-weight: 600;
  
  transition: transform 0.2s ease;
}

.btn-edit:active {
  transform: scale(0.96);
}

.btn-share {
  background: var(--mood-sage-soft);
  color: var(--mood-honey);
  border-radius: 48rpx;
  font-weight: 600;
  
  transition: transform 0.2s ease;
}

.btn-share:active {
  transform: scale(0.96);
}

.btn-delete {
  background-color: var(--mood-rose-soft);
  color: var(--mood-rose);
  border-radius: 48rpx;
  font-weight: 600;
  transition: transform 0.2s ease;
}

.btn-delete:active {
  transform: scale(0.96);
}



/* Page composition and touch geometry. */

.container { min-height: 100vh; padding: 32rpx; }
.header { align-items: center; gap: 16rpx; margin-bottom: 32rpx; flex-wrap: wrap; }
.title { font-size: 44rpx; font-weight: 600; color: var(--mood-ink); line-height: 1.55; margin-bottom: 28rpx; overflow-wrap: anywhere; }
.content { padding: 36rpx; background: var(--mood-surface); border-radius: 32rpx; line-height: 2; font-size: 30rpx; min-height: 280rpx; margin-bottom: 24rpx; white-space: pre-wrap; overflow-wrap: anywhere; }
.actions { display: flex; flex-wrap: wrap; gap: 16rpx; }
.actions button { flex: 1; min-width: 160rpx; min-height: 88rpx; height: auto; line-height: 1.6; padding: 22rpx 12rpx; font-size: 26rpx; }
.actions .btn-edit { background: var(--mood-sage); color: #FFFFFF; }
.content { white-space: normal; }
.content text { white-space: pre-wrap; }

