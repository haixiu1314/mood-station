@import "../../styles/healing.wxss";
/* 情绪小喵聊天页面 */

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--mood-paper);
}

/* 顶部信息栏 */
.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: var(--mood-surface);
  border-bottom: 2rpx solid var(--mood-line);
}

.ai-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.ai-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--mood-sage-soft);
  margin-right: 16rpx;
  border: 4rpx solid var(--mood-surface);
  
  flex-shrink: 0;
}

.ai-meta {
  display: flex;
  flex-direction: column;
}

.ai-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--mood-ink);
}

.ai-desc {
  font-size: 24rpx;
  color: var(--mood-faint);
  margin-top: 4rpx;
}

.model-info {
  margin-left: auto;
  background: var(--mood-well);
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
}

.model-info-text {
  font-size: 22rpx;
  color: var(--mood-muted);
}

.count-info {
  background-color: var(--mood-line);
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
}

.count-text {
  font-size: 24rpx;
  color: var(--mood-honey);
}

/* 聊天内容区域 */
.chat-messages {
  flex: 1;
  padding: 24rpx 24rpx 160rpx 24rpx;
  overflow-y: auto;
}

.message-row {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-end;
}

.user-row {
  flex-direction: row-reverse;
}

.welcome-row {
  margin-bottom: 32rpx;
}

/* 头像 */
.message-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--mood-sage-soft);
  flex-shrink: 0;
  border: 3rpx solid var(--mood-surface);
  
}

.user-avatar {
  background: var(--mood-sage-soft);
  overflow: hidden;
}

.user-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-avatar-text {
  color: var(--mood-surface);
  font-size: 24rpx;
  font-weight: 600;
}

/* 聊天气泡 */
.message-bubble {
  max-width: 70%;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  position: relative;
  word-break: break-all;
}

.ai-bubble {
  background-color: var(--mood-surface);
  color: var(--mood-ink);
  margin-left: 16rpx;
  border-bottom-left-radius: 8rpx;
  
}

.user-bubble {
  background-color: var(--mood-honey-soft);
  color: var(--mood-honey);
  margin-right: 16rpx;
  border-bottom-right-radius: 8rpx;
  
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
}

/* 正在输入指示器 */
.typing-bubble {
  padding: 24rpx 32rpx;
}

.typing-indicator {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--mood-honey);
  animation: typing-bounce 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(1) {
  animation-delay: 0s;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing-bounce {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-12rpx);
    opacity: 1;
  }
}

/* 底部输入区域 */
.chat-input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--mood-surface);
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--mood-line);
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background-color: var(--mood-line);
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--mood-ink);
  border: 2rpx solid transparent;
  transition: transform 0.2s ease;
}

.chat-input:focus {
  background-color: var(--mood-surface);
  border-color: var(--mood-honey-soft);
}

.input-placeholder {
  color: var(--mood-faint);
}

/* 发送按钮 */
.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: var(--mood-line);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s ease;
}

.send-btn.active {
  background: var(--mood-sage-soft);
  transform: scale(1.05);
  
}

.send-btn.active:active {
  transform: scale(0.95);
}

.send-btn.disabled {
  opacity: 0.5;
}

.send-icon {
  color: var(--mood-surface);
  font-size: 28rpx;
  font-weight: 600;
}



/* Page composition and touch geometry. */

.chat-container { height: 100vh; overflow: hidden; padding-bottom: 0; }
.chat-header { padding: 24rpx 28rpx; flex-shrink: 0; border-bottom: 1rpx solid var(--mood-line); background: var(--mood-paper); gap: 16rpx; }
.ai-info { min-width: 0; }
.ai-avatar { width: 80rpx; height: 80rpx; background: var(--mood-honey-soft); border: 0; }
.ai-desc { color: var(--mood-muted); line-height: 1.6; }
.count-info { flex-shrink: 0; background: var(--mood-sage-soft); }
.count-text { color: var(--mood-sage-ink); font-variant-numeric: tabular-nums; }
.chat-messages { min-height: 0; height: 0; width: 100%; flex: 1; padding: 28rpx; }
.message-row { gap: 0; margin-bottom: 28rpx; align-items: flex-start; }
.user-row { flex-direction: row; justify-content: flex-end; }
.message-avatar { background: var(--mood-honey-soft); border: 0; }
.user-avatar { background: var(--mood-sage); }
.message-bubble { max-width: 76%; padding: 24rpx 28rpx; border-radius: 28rpx; }
.ai-bubble { border-top-left-radius: 8rpx; border-bottom-left-radius: 28rpx; }
.user-bubble { background: var(--mood-sage-soft); color: var(--mood-ink); border-top-right-radius: 8rpx; border-bottom-right-radius: 28rpx; }
.message-text { font-size: 28rpx; line-height: 1.9; white-space: pre-wrap; }
.typing-dot { background: var(--mood-sage); }
.chat-input-area { position: relative; flex-shrink: 0; padding: 20rpx 28rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--mood-line); }
.chat-input { min-width: 0; height: 88rpx; background: var(--mood-well); border-radius: 999rpx; }
.send-btn { width: 88rpx; height: 88rpx; flex-shrink: 0; background: var(--mood-well); }
.send-btn.active { background: var(--mood-sage); transform: none; }
.send-btn.disabled { opacity: .6; }
.send-icon { width: 38rpx; height: 38rpx; }
@media (prefers-reduced-motion: reduce) { .typing-dot { animation: none; } .send-btn { transition: none; } }


.send-btn { background: var(--mood-muted); }

/* AI 配置提示弹窗 */
.config-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(62, 51, 42, 0.5);
  z-index: 1000;
}

.config-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: var(--mood-surface);
  border-radius: 28rpx;
  padding: 20rpx 32rpx 40rpx;
  z-index: 1001;
  box-sizing: border-box;
}

.config-modal-header {
  display: flex;
  justify-content: flex-end;
}

.config-modal-close {
  font-size: 44rpx;
  color: var(--mood-faint);
  line-height: 1;
  padding: 8rpx;
}

.config-modal-body {
  padding: 16rpx 8rpx 32rpx;
  text-align: center;
}

.config-modal-text {
  font-size: 28rpx;
  color: var(--mood-ink);
  line-height: 1.7;
}

.config-modal-footer {
  display: flex;
  justify-content: center;
}

.config-go-btn {
  position: relative;
  width: 320rpx;
  height: 84rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: linear-gradient(180deg, #A99882 0%, #8A7A68 100%);
  box-shadow: 0 6rpx 0 #6F6050, 0 10rpx 20rpx rgba(138, 122, 104, 0.3), inset 0 2rpx 0 rgba(255, 255, 255, 0.25);
}

.config-go-btn-text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  position: relative;
  z-index: 1;
}

/* 快捷选项（进入时依次渐显） */
.quick-options {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 16rpx 24rpx 8rpx;
  background: var(--mood-paper);
}

.quick-option {
  margin-bottom: 12rpx;
  background: var(--mood-surface);
  border: 2rpx solid var(--mood-line);
  border-radius: 32rpx;
  padding: 14rpx 28rpx;
  display: inline-flex;
  align-items: center;
  opacity: 0;
  animation: quick-fade-in 0.5s ease forwards;
}

.quick-option:last-child { margin-bottom: 0; }

.quick-option:nth-child(1) { animation-delay: 0.1s; }
.quick-option:nth-child(2) { animation-delay: 0.25s; }
.quick-option:nth-child(3) { animation-delay: 0.4s; }

.quick-option-text {
  font-size: 24rpx;
  color: var(--mood-muted);
}

@keyframes quick-fade-in {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
