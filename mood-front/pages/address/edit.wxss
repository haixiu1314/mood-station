@import "../../styles/healing.wxss";
.container {
  padding: 32rpx;
  padding-bottom: 120rpx;
  background-color: var(--mood-paper);
  min-height: 100vh;
  box-sizing: border-box;
}

.form-group {
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  color: var(--mood-ink);
  margin-bottom: 16rpx;
  display: block;
  font-weight: 600;
}

.input {
  background-color: var(--mood-surface);
  border-radius: 20rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: var(--mood-ink);
  border: 2rpx solid var(--mood-line);
  box-sizing: border-box;
  transition: transform 0.2s ease;
  width: 100%;
  height: 96rpx;
}

.input:focus {
  background-color: var(--mood-surface);
  border-color: var(--mood-sage-soft);
  
}

.picker {
  background-color: var(--mood-surface);
  border-radius: 20rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: var(--mood-ink);
  border: 2rpx solid var(--mood-line);
  box-sizing: border-box;
  transition: transform 0.2s ease;
  display: flex;
  align-items: center;
  height: 96rpx;
}

.picker .placeholder {
  color: var(--mood-faint);
}

.textarea {
  background-color: var(--mood-surface);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  color: var(--mood-ink);
  border: 2rpx solid var(--mood-line);
  min-height: 200rpx;
  width: 100%;
  box-sizing: border-box;
  transition: transform 0.2s ease;
  line-height: 1.6;
}

.textarea:focus {
  border-color: var(--mood-sage-soft);
  
}

.switch-group {
  display: flex;
  align-items: center;
}

.switch-group switch {
  margin-right: 16rpx;
  transform: scale(0.8);
}

.switch-label {
  font-size: 28rpx;
  color: var(--mood-muted);
}

.actions {
  margin-top: 48rpx;
}

.btn-save {
  background: var(--mood-sage-soft);
  color: var(--mood-surface);
  border-radius: 40rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  
  transition: transform 0.2s ease;
}

.btn-save::after {
  border: none;
}

.btn-save:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.btn-cancel {
  background-color: var(--mood-paper);
  color: var(--mood-muted);
  border-radius: 40rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: 2rpx solid var(--mood-line);
  transition: transform 0.2s ease;
}

.btn-cancel::after {
  border: none;
}

.btn-cancel:active {
  transform: scale(0.96);
  background-color: var(--mood-line);
}



/* Page composition and touch geometry. */

.container { padding: 28rpx 32rpx calc(56rpx + env(safe-area-inset-bottom)); min-height: 100vh; }
.form-group { margin-bottom: 32rpx; }
.form-group .label { display: block; margin-bottom: 14rpx; }
.textarea { min-height: 360rpx; padding: 28rpx; height: 420rpx; }
.emotion-selector { padding: 24rpx; background: #FFFFFF; border-radius: 28rpx; margin-bottom: 28rpx; display: flex; justify-content: space-between; align-items: center; gap: 20rpx; }
.emotion-selector .label { margin-bottom: 0; }
.emotion-selector .picker { padding: 12rpx; min-height: 64rpx; background: transparent; display: flex; align-items: center; }
.actions { gap: 20rpx; }
.switch-label { color: var(--mood-muted); line-height: 1.8; }

