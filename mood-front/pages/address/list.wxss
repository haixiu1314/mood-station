@import "../../styles/healing.wxss";
.container {
  padding: 32rpx;
  padding-bottom: 160rpx;
  background-color: var(--mood-paper);
  min-height: 100vh;
  box-sizing: border-box;
}

.address-list {
  margin-bottom: 32rpx;
}

.address-item {
  margin-bottom: 24rpx;
  background-color: var(--mood-surface);
  border-radius: 20rpx;
  padding: 28rpx 28rpx 28rpx 40rpx;
  
  transition: transform 0.2s ease;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  animation: none;
  border: 2rpx solid #FFF5E6;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.address-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 10rpx;
  background: var(--mood-sage-soft);
  border-radius: 0 6rpx 6rpx 0;
}

.address-item:active {
  transform: scale(0.98);
  
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.name {
  font-size: 32rpx;
  color: var(--mood-ink);
  font-weight: 700;
  margin-right: 24rpx;
}

.phone {
  font-size: 28rpx;
  color: var(--mood-muted);
}

.default-tag {
  font-size: 24rpx;
  color: var(--mood-sage-ink);
  background: var(--mood-sage-soft);
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  margin-left: 16rpx;
  font-weight: 600;
}

.address-detail {
  font-size: 28rpx;
  color: var(--mood-ink);
  line-height: 1.6;
  display: block;
  margin-bottom: 20rpx;
}

.address-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  font-size: 26rpx;
  color: var(--mood-sage);
  padding: 10rpx 24rpx;
  border: 2rpx solid var(--mood-sage-soft);
  border-radius: 40rpx;
  background-color: var(--mood-paper);
  transition: transform 0.2s ease;
  font-weight: 500;
}

.action-btn:active {
  transform: scale(0.96);
}

.action-btn.delete {
  color: var(--mood-rose);
  border-color: #FFD0D0;
  background-color: var(--mood-rose-soft);
}

.action-btn.set-default {
  color: var(--mood-sage);
  border-color: var(--mood-sage-soft);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: var(--mood-faint);
  font-size: 28rpx;
}

/* 添加按钮 */
.add-btn {
  position: fixed;
  bottom: 40rpx;
  left: 32rpx;
  right: 32rpx;
  background: var(--mood-sage-soft);
  color: var(--mood-surface);
  text-align: center;
  padding: 24rpx 0;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 700;
  
  transition: transform 0.2s ease;
  z-index: 100;
}

.add-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}



/* Page composition and touch geometry. */

.container { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.address-item { padding: 28rpx; border-radius: 32rpx; }
.address-item::before { display: none; }
.address-header { flex-wrap: wrap; gap: 16rpx; }
.name { color: var(--mood-ink); font-size: 30rpx; font-weight: 600; }
.phone, .address-detail { color: var(--mood-muted); font-size: 28rpx; line-height: 1.8; }
.default-tag { color: var(--mood-sage-ink); background: var(--mood-sage-soft); }
.address-actions { gap: 12rpx; flex-wrap: wrap; border-top: 1rpx solid var(--mood-line); }
.action-btn { min-height: 80rpx; display: flex; align-items: center; padding: 12rpx 20rpx; }
.add-btn { left: 32rpx; right: 32rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); background: var(--mood-sage); color: #FFFFFF; border-radius: 999rpx; min-height: 96rpx; box-shadow: 0 6rpx 20rpx rgba(41,60,51,.12); }

