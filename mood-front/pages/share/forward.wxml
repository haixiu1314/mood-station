<view class="container mood-page mood-share-forward">
  <view class="header">
    <text class="title">选择要转发的日记</text>
    <text class="subtitle">选择一篇日记转发到情绪分享社区</text>
  </view>

  <view class="diary-list" wx:if="{{diaries.length > 0}}">
    <view class="diary-card" wx:for="{{diaries}}" wx:key="id" bindtap="onSelectDiary" data-id="{{item.id}}" hover-class="mood-pressed" hover-start-time="20" hover-stay-time="90">
      <view class="diary-header">
        <view class="emotion-tag emotion-{{item.emotion}}" style="background-color: {{emotionMap[item.emotion].bg}}; color: {{emotionMap[item.emotion].color}}">
          <image class="emotion-icon" src="/images/healing/mood-{{item.emotion}}.png" mode="aspectFit"></image>
          {{emotionMap[item.emotion].label}}
        </view>
        <text class="diary-time">{{item.createTime}}</text>
      </view>
      <text class="diary-title" wx:if="{{item.title}}">{{item.title}}</text>
      <text class="diary-content">{{item.content}}</text>
      <view class="diary-footer">
        <text class="select-hint">点击转发</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{diaries.length === 0 && !loading}}">
    <image class="empty-icon" src="/images/healing/leaf.png" mode="aspectFit"></image>
    <text class="empty-text">还没有日记，先去写一篇吧~</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
