@import "../../styles/healing.wxss";
.container {
  min-height: 100vh;
  background: var(--mood-paper);
  padding: 32rpx;
}

.header {
  margin-bottom: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--mood-ink);
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: var(--mood-faint);
}

.diary-list {
  padding-bottom: 32rpx;
}

.diary-card {
  background: var(--mood-surface);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  
  border: 1rpx solid rgba(230, 230, 230, 0.5);
  transition: transform 0.2s ease;
}

.diary-card:active {
  transform: scale(0.98);
  
}

.diary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.emotion-tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.emotion-icon {
  margin-right: 6rpx;
  font-size: 26rpx;
}

.diary-time {
  font-size: 24rpx;
  color: var(--mood-faint);
}

.diary-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--mood-ink);
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.diary-content {
  font-size: 26rpx;
  color: var(--mood-muted);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
}

.diary-footer {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--mood-line);
}

.select-hint {
  font-size: 24rpx;
  color: var(--mood-sage-soft);
  font-weight: 600;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--mood-faint);
}

.loading {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: var(--mood-faint);
}



/* Page composition and touch geometry. */

.container { min-height: 100vh; }
.header-bar { gap: 16rpx; margin-bottom: 24rpx; }
.search-bar { min-height: 88rpx; background: var(--mood-surface); border: 0; border-radius: 999rpx; }
.search-input { color: var(--mood-ink); min-width: 0; }
.trash-btn { width: 88rpx; height: 88rpx; border-radius: 50%; background: var(--mood-well); }
.filter-btn { min-height: 80rpx; border: 0; border-radius: 999rpx; background: var(--mood-well); }
.filter-btn.active { background: var(--mood-sage-soft); color: var(--mood-sage-ink); }
.diary-card, .post-card, .trash-card { padding: 28rpx; border-radius: 32rpx; margin-bottom: 24rpx; }
.diary-card::before, .post-card::before { display: none; }
.diary-header, .post-header, .trash-header { gap: 12rpx; flex-wrap: wrap; }
.diary-title, .post-title, .trash-title { color: var(--mood-ink); font-size: 30rpx; font-weight: 600; line-height: 1.7; }
.diary-content, .post-content, .trash-content { color: var(--mood-muted); font-size: 28rpx; line-height: 1.85; }
.diary-footer, .post-footer, .trash-footer { border-top-width: 1rpx; }
.delete-btn, .more-btn { min-height: 72rpx; min-width: 88rpx; display: flex; align-items: center; justify-content: center; }
.trash-tip { border-radius: 24rpx; background: var(--mood-honey-soft); color: var(--mood-honey); padding: 24rpx; }
.tip-text, .expire-text { color: var(--mood-honey); font-size: 24rpx; }
.action-content, .action-popup { border-radius: 36rpx 36rpx 0 0; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.action-item { min-height: 100rpx; }

.header { background: transparent; padding: 8rpx 0 28rpx; }
.title { color: var(--mood-ink); font-size: 42rpx; font-weight: 600; }
.subtitle { color: var(--mood-muted); font-size: 26rpx; }
.select-hint { color: var(--mood-sage-ink); font-size: 26rpx; padding: 12rpx 0; }

