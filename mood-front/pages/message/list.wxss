@import "../../styles/healing.wxss";
.container {
  min-height: 100vh;
  background-color: var(--mood-paper);
  box-sizing: border-box;
}

/* Tab 切换 */
.tabs {
  display: flex;
  background: var(--mood-surface);
  border-bottom: 2rpx solid var(--mood-line);
  position: sticky;
  top: 0;
  z-index: 10;
  
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: var(--mood-muted);
  position: relative;
  transition: transform 0.3s;
  font-weight: 500;
}

.tab-item.active {
  color: var(--mood-sage);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--mood-sage-soft);
  border-radius: 3rpx;
}

/* 内容区域 */
.content-section {
  padding: 24rpx 32rpx;
}

/* 留言列表 */
.message-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.message-item {
  background: var(--mood-surface);
  border-radius: 20rpx;
  padding: 28rpx 28rpx 28rpx 40rpx;
  
  box-sizing: border-box;
  transition: transform 0.2s ease;
  animation: none;
  position: relative;
  overflow: hidden;
  border: 2rpx solid #FFF5E6;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.message-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 10rpx;
  background: var(--mood-sage-soft);
  border-radius: 0 6rpx 6rpx 0;
}

.message-item:active {
  transform: scale(0.98);
  
}

.message-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
  border: 2rpx solid var(--mood-sage-soft);
}

.message-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mood-ink);
}

.time {
  font-size: 24rpx;
  color: var(--mood-faint);
  margin-top: 4rpx;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  background: var(--mood-rose);
  border-radius: 50%;
  flex-shrink: 0;
  
}

.message-content {
  font-size: 28rpx;
  color: var(--mood-muted);
  line-height: 1.6;
  padding-left: 76rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: var(--mood-faint);
  font-size: 28rpx;
}



/* Page composition and touch geometry. */

.tabs, .tab-bar { background: transparent; border-bottom: 1rpx solid var(--mood-line); padding: 0; margin-bottom: 28rpx; }
.tab-item, .tab { min-height: 92rpx; line-height: 1.5; display: flex; align-items: center; justify-content: center; padding: 24rpx 12rpx; color: var(--mood-muted); font-size: 27rpx; }
.tab-item.active, .tab.active, .tab-item.active .tab-text { color: var(--mood-sage-ink); font-weight: 600; }
.tab-item.active::after, .tab.active::after { height: 4rpx; background: var(--mood-sage); border-radius: 2rpx; }

.message-item, .notification-item { padding: 28rpx; background: #FFFFFF; border-radius: 28rpx; margin-bottom: 20rpx; }
.message-item::before { display: none; }
.message-content, .notification-text { font-size: 28rpx; color: var(--mood-muted); line-height: 1.85; white-space: pre-wrap; }
.message-header, .notification-header { gap: 16rpx; }
.message-info, .notification-content { min-width: 0; }
.notification-time { flex-shrink: 0; font-size: 24rpx; color: var(--mood-faint); }
.notification-title { font-weight: 600; color: var(--mood-ink); }

