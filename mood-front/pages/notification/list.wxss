@import "../../styles/healing.wxss";
.container {
  min-height: 100vh;
  background: var(--mood-paper);
}

/* Tab栏 */
.tab-bar {
  display: flex;
  background: var(--mood-surface);
  border-bottom: 1rpx solid var(--mood-line);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  position: relative;
}

.tab-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--mood-sage-soft);
  border-radius: 2rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.tab-item.active::after {
  opacity: 1;
}

.tab-text {
  font-size: 28rpx;
  color: var(--mood-faint);
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: var(--mood-sage-ink);
  font-weight: 700;
}

.tab-badge {
  position: absolute;
  top: 12rpx;
  right: 50%;
  margin-right: -60rpx;
  min-width: 28rpx;
  height: 28rpx;
  background: var(--mood-rose);
  color: var(--mood-surface);
  font-size: 24rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  
}

/* 通知列表 */
.notification-list {
  padding: 16rpx;
}

.notification-item {
  position: relative;
  background: var(--mood-surface);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  
  transition: transform 0.2s ease;
}

.notification-item:active {
  transform: scale(0.98);
}

.notification-dot {
  position: absolute;
  top: 32rpx;
  left: 12rpx;
  width: 12rpx;
  height: 12rpx;
  background: var(--mood-sage-soft);
  border-radius: 50%;
  animation: dot-pulse 2s ease-in-out infinite;
}

@keyframes dot-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.notification-content {
  padding-left: 16rpx;
}

.notification-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.notification-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mood-sage-ink);
}

.notification-time {
  font-size: 24rpx;
  color: var(--mood-faint);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.notification-text {
  font-size: 26rpx;
  color: var(--mood-muted);
  line-height: 1.6;
  word-break: break-all;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.3;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--mood-faint);
}



/* Page composition and touch geometry. */

.tabs, .tab-bar { background: transparent; border-bottom: 1rpx solid var(--mood-line); padding: 0; margin-bottom: 28rpx; }
.tab-item, .tab { min-height: 92rpx; line-height: 1.5; display: flex; align-items: center; justify-content: center; padding: 24rpx 12rpx; color: var(--mood-muted); font-size: 27rpx; }
.tab-item.active, .tab.active, .tab-item.active .tab-text { color: var(--mood-sage-ink); font-weight: 600; }
.tab-item.active::after, .tab.active::after { height: 4rpx; background: var(--mood-sage); border-radius: 2rpx; }

.message-item, .notification-item { padding: 28rpx; background: var(--mood-surface); border-radius: 28rpx; margin-bottom: 20rpx; }
.message-item::before { display: none; }
.message-content, .notification-text { font-size: 28rpx; color: var(--mood-muted); line-height: 1.85; white-space: pre-wrap; }
.message-header, .notification-header { gap: 16rpx; }
.message-info, .notification-content { min-width: 0; }
.notification-time { flex-shrink: 0; font-size: 24rpx; color: var(--mood-faint); }
.notification-title { font-weight: 600; color: var(--mood-ink); }

