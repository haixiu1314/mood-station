@import "../../styles/healing.wxss";
.page-container { box-sizing: border-box; width: 100%; min-height: 100vh; padding: 12rpx 32rpx 56rpx; background: var(--mood-paper); }
.welcome-banner { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0 32rpx; }
.welcome-left { min-width: 0; flex: 1; }
.welcome-name { display: block; color: var(--mood-ink); font-size: 44rpx; line-height: 1.35; font-weight: 600; overflow-wrap: anywhere; }
.welcome-subtitle { display: block; font-size: 25rpx; line-height: 1.7; color: var(--mood-muted); margin-top: 14rpx; }
.welcome-mark { width: 100rpx; height: 100rpx; flex-shrink: 0; margin-left: 24rpx; }
.banner-swiper { height: 272rpx; width: 100%; border-radius: 32rpx; overflow: hidden; background: var(--mood-sage-soft); margin-bottom: 24rpx; }
.banner-image { width: 100%; height: 100%; }
.tip-card { background: var(--mood-sage-soft); border-radius: 32rpx; padding: 28rpx; min-height: 148rpx; transition: opacity 160ms ease, transform 160ms ease; }
.tip-front { display: flex; align-items: center; min-height: 92rpx; }
.tip-icon { width: 56rpx; height: 56rpx; margin-right: 24rpx; flex-shrink: 0; }
.tip-text-group { flex: 1; min-width: 0; }
.tip-title { display: block; font-size: 28rpx; font-weight: 600; color: var(--mood-sage-ink); }
.tip-hint { display: block; margin-top: 6rpx; font-size: 24rpx; color: var(--mood-muted); }
.tip-arrow { width: 32rpx; height: 32rpx; }
.tip-back { display: flex; }
.tip-card.flipped .tip-front { transform: rotateY(-180deg); }
.tip-card.flipped .tip-back { transform: rotateY(0); }
.tip-back-label { display: block; font-size: 24rpx; color: var(--mood-muted); margin-bottom: 10rpx; }
.tip-back-text { display: block; font-size: 28rpx; line-height: 1.8; color: var(--mood-sage-ink); overflow-wrap: anywhere; }
.diary-section-title { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 40rpx 0 24rpx; }
.title-text { display: block; font-size: 34rpx; font-weight: 600; color: var(--mood-ink); }
.section-caption { display: block; color: var(--mood-muted); font-size: 24rpx; margin-top: 6rpx; }
.write-diary-btn { display: flex; align-items: center; justify-content: center; padding: 16rpx 24rpx; border-radius: 999rpx; background: var(--mood-sage); min-height: 88rpx; flex-shrink: 0; }
.write-icon { width: 28rpx; height: 28rpx; margin-right: 8rpx; }
.write-btn-text { color: #FFFFFF; font-size: 26rpx; font-weight: 500; }
.diary-list { width: 100%; }
.diary-card { background: var(--mood-surface); padding: 28rpx; border-radius: 32rpx; margin-bottom: 20rpx; }
.diary-card-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.emotion-tag { display: inline-flex; align-items: center; }
.diary-time { font-size: 24rpx; color: var(--mood-faint); text-align: right; }
.diary-title { display: block; color: var(--mood-ink); font-size: 30rpx; font-weight: 600; margin-bottom: 10rpx; overflow-wrap: anywhere; }
.diary-content { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 27rpx; line-height: 1.85; color: var(--mood-muted); }
.input-card { display: flex; gap: 20rpx; align-items: center; padding: 28rpx; background: var(--mood-well); border-radius: 32rpx; margin-top: 24rpx; }
.input-card > view { flex: 1; min-width: 0; }
.pen-icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.input-main-text { display: block; font-size: 27rpx; color: var(--mood-sage-ink); font-weight: 500; }
.input-sub-text { display: block; font-size: 24rpx; color: var(--mood-muted); margin-top: 6rpx; }
.input-arrow { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.empty-state { padding: 52rpx 24rpx; }
@media (prefers-reduced-motion: reduce) { .tip-card.flipped .tip-back { animation: none; } }

/* Keep the original two-sided fortune interaction. Both faces stay mounted. */
.tip-card { position: relative; height: 192rpx; padding: 0; perspective: 1200rpx; background: transparent; }
.tip-front, .tip-back { position: absolute; top: 0; left: 0; width: 100%; height: 100%; min-height: 0; padding: 28rpx; border-radius: 32rpx; box-sizing: border-box; backface-visibility: hidden; -webkit-backface-visibility: hidden; transition: transform 600ms ease-in-out; }
.tip-front { background: var(--mood-sage-soft); transform: rotateY(0); z-index: 2; }
.tip-back { background: #476B55; transform: rotateY(180deg); flex-direction: column; align-items: center; justify-content: center; overflow: hidden; text-align: center; }
.tip-back-label { color: #E5EEE4; margin-bottom: 8rpx; position: relative; z-index: 1; }
.tip-back-text { color: #FFFFFF; font-size: 28rpx; line-height: 1.65; position: relative; z-index: 1; padding: 0 16rpx; }
.stars-container { position: absolute; inset: 0; pointer-events: none; }
.star { position: absolute; width: 8rpx; height: 8rpx; border-radius: 50%; background: #FFF3CF; opacity: .3; animation: none; }
.tip-card.flipped .star { animation: tip-twinkle 2s ease-in-out infinite; }
.star-1 { top: 15%; left: 12%; }.star-2 { top: 22%; right: 18%; }.star-3 { bottom: 16%; left: 27%; }.star-4 { top: 57%; left: 7%; }.star-5 { bottom: 27%; right: 8%; }
.tip-card.flipped .star-2 { animation-delay: .4s; }.tip-card.flipped .star-3 { animation-delay: .8s; }.tip-card.flipped .star-4 { animation-delay: 1.2s; }.tip-card.flipped .star-5 { animation-delay: 1.6s; }
@keyframes tip-twinkle { 0%,100% { opacity: .25; transform: scale(.8); } 50% { opacity: 1; transform: scale(1.5); box-shadow: 0 0 12rpx 3rpx rgba(255,243,207,.45); } }
.diary-scroll { display: block; height: 480rpx; width: 100%; background: var(--mood-well); border-radius: 32rpx; overflow: hidden; }
.diary-list { padding: 16rpx; box-sizing: border-box; }
.diary-card:last-child { margin-bottom: 0; }
@media (prefers-reduced-motion: reduce) { .tip-front, .tip-back { transition: none; } .tip-card.flipped .star { animation: none; opacity: .7; } }
