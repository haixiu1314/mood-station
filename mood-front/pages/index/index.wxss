@import "../../styles/healing.wxss";
.page-container { box-sizing: border-box; width: 100%; min-height: 100vh; padding: 12rpx 32rpx 56rpx; background: var(--mood-paper); }
.welcome-banner { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0 32rpx; }
.welcome-left { min-width: 0; flex: 1; }
.welcome-name { display: block; color: var(--mood-ink); font-size: 44rpx; line-height: 1.35; font-weight: 600; overflow-wrap: anywhere; }
.welcome-subtitle { display: block; font-size: 25rpx; line-height: 1.7; color: var(--mood-muted); margin-top: 14rpx; }
.time-tip { display: block; margin-top: 12rpx; font-size: 23rpx; line-height: 1.6; color: #4A7C59; }
.welcome-mark { width: 104rpx; height: 104rpx; flex-shrink: 0; margin-left: 24rpx; filter: drop-shadow(0 4rpx 8rpx rgba(120,90,60,.18)); }
.banner-swiper { height: 272rpx; width: 100%; border-radius: 32rpx; overflow: hidden; background: var(--mood-sage-soft); margin-bottom: 24rpx; }
.banner-image { width: 100%; height: 100%; }

/* 每日锦囊：图标 + 四字居中，多圈翻转后缓停 */
.tip-card { position: relative; height: 240rpx; padding: 0; perspective: 1200rpx; background: transparent; }
.tip-front, .tip-back { position: absolute; top: 0; left: 0; width: 100%; height: 100%; min-height: 0; padding: 28rpx; border-radius: 32rpx; box-sizing: border-box; backface-visibility: hidden; -webkit-backface-visibility: hidden; transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1); }
.tip-front { background: var(--mood-sage-soft); transform: rotateY(0); z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; box-shadow: 0 8rpx 0 #EADBC8, 0 14rpx 28rpx rgba(120,90,60,.16), inset 0 2rpx 0 rgba(255,255,255,.7); }
.tip-icon { width: 118rpx; height: 118rpx; flex-shrink: 0; filter: drop-shadow(0 8rpx 12rpx rgba(120,90,60,.22)); }
.tip-title { font-size: 28rpx; font-weight: 600; color: #4A7C59; letter-spacing: 2rpx; }
.tip-back { background: linear-gradient(180deg, #6BA184 0%, #4A7C59 100%); transform: rotateY(180deg); display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; text-align: center; box-shadow: 0 8rpx 0 #3D6649, 0 14rpx 28rpx rgba(74,124,89,.28), inset 0 2rpx 0 rgba(255,255,255,.22); }
.tip-card.flipped .tip-front { transform: rotateY(-900deg); }
.tip-card.flipped .tip-back { transform: rotateY(-720deg); }
.tip-back-label { color: #EAF3EC; margin-bottom: 8rpx; position: relative; z-index: 1; font-size: 24rpx; }
.tip-back-text { color: #FFFFFF; font-size: 28rpx; line-height: 1.65; position: relative; z-index: 1; padding: 0 16rpx; }
.stars-container { position: absolute; inset: 0; pointer-events: none; }
.star { position: absolute; width: 8rpx; height: 8rpx; border-radius: 50%; background: #FFF3CF; opacity: .3; animation: none; }
.tip-card.flipped .star { animation: tip-twinkle 2s ease-in-out infinite; }
.star-1 { top: 15%; left: 12%; }.star-2 { top: 22%; right: 18%; }.star-3 { bottom: 16%; left: 27%; }.star-4 { top: 57%; left: 7%; }.star-5 { bottom: 27%; right: 8%; }
.tip-card.flipped .star-2 { animation-delay: .4s; }.tip-card.flipped .star-3 { animation-delay: .8s; }.tip-card.flipped .star-4 { animation-delay: 1.2s; }.tip-card.flipped .star-5 { animation-delay: 1.6s; }
@keyframes tip-twinkle { 0%,100% { opacity: .25; transform: scale(.8); } 50% { opacity: 1; transform: scale(1.5); box-shadow: 0 0 12rpx 3rpx rgba(255,243,207,.45); } }

.diary-section-title { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 40rpx 0 24rpx; }
.title-text { display: block; font-size: 34rpx; font-weight: 600; color: var(--mood-ink); }
.section-caption { display: block; color: var(--mood-muted); font-size: 24rpx; margin-top: 6rpx; }

/* 写日记：立体可爱 + 高光扫光动画 */
.write-diary-btn { position: relative; display: flex; align-items: center; justify-content: center; padding: 16rpx 30rpx; border-radius: 999rpx; min-height: 88rpx; flex-shrink: 0; overflow: hidden; background: linear-gradient(180deg, #F3A88A 0%, #E98D6F 55%, #D9774F 100%); box-shadow: 0 6rpx 0 #C96A45, 0 12rpx 24rpx rgba(217,119,79,.32), inset 0 2rpx 0 rgba(255,255,255,.32); }
.write-diary-btn::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 50%; background: linear-gradient(180deg, rgba(255,255,255,.32), rgba(255,255,255,0)); border-radius: 999rpx 999rpx 0 0; pointer-events: none; }
.write-diary-btn::after { content: ''; position: absolute; top: -60%; left: -80%; width: 45%; height: 220%; background: linear-gradient(105deg, transparent 0%, rgba(255,255,255,.65) 50%, transparent 100%); transform: skewX(-20deg); pointer-events: none; animation: btn-shine 2.6s ease-in-out infinite; }
.write-icon { width: 28rpx; height: 28rpx; margin-right: 8rpx; position: relative; z-index: 1; }
.write-btn-text { color: #FFFFFF; font-size: 26rpx; font-weight: 500; position: relative; z-index: 1; }
@keyframes btn-shine { 0% { left: -80%; } 55%, 100% { left: 130%; } }

.diary-list { width: 100%; }
.diary-card { background: var(--mood-surface); padding: 28rpx; border-radius: 32rpx; margin-bottom: 20rpx; }
.diary-card-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.emotion-tag { display: inline-flex; align-items: center; }
.diary-time { font-size: 24rpx; color: var(--mood-faint); text-align: right; }
.diary-title { display: block; color: var(--mood-ink); font-size: 30rpx; font-weight: 600; margin-bottom: 10rpx; overflow-wrap: anywhere; }
.diary-content { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 27rpx; line-height: 1.85; color: var(--mood-muted); }
.empty-state { padding: 52rpx 24rpx; }
.diary-scroll { display: block; height: 520rpx; width: 100%; background: var(--mood-well); border-radius: 32rpx; overflow: hidden; }
.diary-list { padding: 16rpx; box-sizing: border-box; }
.diary-card:last-child { margin-bottom: 0; }
@media (prefers-reduced-motion: reduce) {
  .tip-front, .tip-back { transition: none; }
  .tip-card.flipped .star { animation: none; opacity: .7; }
  .write-diary-btn::after { animation: none; }
}
