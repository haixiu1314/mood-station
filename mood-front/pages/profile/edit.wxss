@import "../../styles/healing.wxss";
.container {
  padding: 24rpx;
  padding-bottom: 160rpx;
  background-color: var(--mood-paper);
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: var(--mood-surface);
  border-radius: 20rpx;
  
  margin-bottom: 24rpx;
  overflow: hidden;
  box-sizing: border-box;
  animation: none;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 头像区域 */
.avatar-section {
  display: flex;
  align-items: center;
  padding: 32rpx;
  transition: background-color 0.2s ease;
}

.avatar-section:active {
  background-color: var(--mood-paper);
}

.avatar-left {
  margin-right: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid var(--mood-sage-soft);
  
}

.avatar-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.avatar-right .label {
  font-size: 30rpx;
  color: var(--mood-ink);
  font-weight: 600;
}

.avatar-right .tip {
  font-size: 24rpx;
  color: var(--mood-faint);
  margin-top: 8rpx;
}

.arrow {
  font-size: 36rpx;
  color: #D0C8C0;
  margin-left: auto;
  flex-shrink: 0;
}

/* 表单区域 */
.form-section {
  padding: 0 32rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  min-height: 88rpx;
  border-bottom: 2rpx solid var(--mood-line);
  box-sizing: border-box;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.vertical {
  flex-direction: column;
  align-items: flex-start;
  padding-bottom: 20rpx;
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: var(--mood-ink);
  font-weight: 500;
  width: 140rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--mood-ink);
  text-align: right;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: var(--mood-ink);
  background: var(--mood-paper);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--mood-line);
  transition: transform 0.2s ease;
}

.form-textarea:focus {
  border-color: var(--mood-sage-soft);
  background-color: var(--mood-surface);
}

.char-count {
  font-size: 24rpx;
  color: var(--mood-faint);
  align-self: flex-end;
  margin-top: 8rpx;
}

.picker-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.picker-value .placeholder {
  color: var(--mood-faint);
}

.picker-value text {
  font-size: 28rpx;
  color: var(--mood-ink);
}

.divider {
  height: 1rpx;
  background: var(--mood-line);
}

/* 保存按钮 */
.save-btn-wrap {
  padding: 24rpx 0;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: var(--mood-sage-soft);
  color: var(--mood-surface);
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
  
  transition: transform 0.2s ease;
}

.save-btn::after {
  border: none;
}

.save-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 修改密码弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: var(--mood-surface);
  border-radius: 24rpx;
  overflow: hidden;
  
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--mood-line);
}

.modal-title {
  font-size: 32rpx;
  color: var(--mood-ink);
  font-weight: 600;
}

.modal-close {
  font-size: 48rpx;
  color: var(--mood-faint);
  line-height: 1;
  padding: 0 8rpx;
  transition: transform 0.2s ease;
}

.modal-close:active {
  transform: scale(0.9);
}

.modal-body {
  padding: 32rpx;
  box-sizing: border-box;
}

.pwd-item {
  margin-bottom: 24rpx;
}

.pwd-item:last-child {
  margin-bottom: 0;
}

.pwd-label {
  font-size: 26rpx;
  color: var(--mood-muted);
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}

.pwd-input {
  width: 100%;
  height: 72rpx;
  background: var(--mood-paper);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--mood-ink);
  box-sizing: border-box;
  border: 2rpx solid var(--mood-line);
  transition: transform 0.2s ease;
}

.pwd-input:focus {
  border-color: var(--mood-sage-soft);
  background-color: var(--mood-surface);
}

.modal-footer {
  display: flex;
  padding: 24rpx 32rpx;
  gap: 24rpx;
  border-top: 1rpx solid var(--mood-line);
  box-sizing: border-box;
}

.modal-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: transform 0.2s ease;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  background: var(--mood-paper);
  color: var(--mood-muted);
  border: 2rpx solid var(--mood-line);
}

.modal-btn.confirm {
  background: var(--mood-sage-soft);
  color: var(--mood-surface);
  
}

.modal-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}



/* Page composition and touch geometry. */

.avatar-section { background: var(--mood-sage-soft); padding: 28rpx; }
.avatar { width: 112rpx; height: 112rpx; border: 4rpx solid #FFFFFF; }
.form-section { padding: 8rpx 28rpx; }
.form-item { min-height: 100rpx; padding: 28rpx 0; gap: 24rpx; }
.form-label { width: 128rpx; flex-shrink: 0; }
.form-input { font-size: 28rpx; min-width: 0; }
.form-item.vertical .form-label { width: auto; margin-bottom: 16rpx; }
.form-textarea { padding: 24rpx; min-height: 220rpx; }
.save-btn-wrap { margin-top: 32rpx; }
.modal-btn.confirm { color: #FFFFFF; background: var(--mood-sage); }
.modal-btn.cancel { background: var(--mood-well); color: var(--mood-muted); }
.modal-close { min-width: 72rpx; min-height: 72rpx; display: flex; align-items: center; justify-content: center; }
.form-section .divider { display: none; }
.form-item { padding: 16rpx 0; }
.form-item.vertical { padding: 24rpx 0; }
.form-input { border: 0; background: transparent; height: 72rpx; }
.save-btn { width: 100%; }

