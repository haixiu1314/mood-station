@import "../../styles/healing.wxss";
.container {
  padding: 0;
  padding-bottom: 120rpx;
  background-color: var(--mood-paper);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部用户信息卡片 */
.header {
  margin: 0;
  border-radius: 0 0 32rpx 32rpx;
  overflow: hidden;
  background: var(--mood-sage-soft);
  min-height: 360rpx;
  position: relative;
  box-sizing: border-box;
}

/* 装饰圆形 */
.header::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  pointer-events: none;
}

.header::after {
  content: '';
  position: absolute;
  bottom: 40rpx;
  left: 40rpx;
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  pointer-events: none;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 80rpx 32rpx 32rpx;
  position: relative;
  z-index: 1;
  box-sizing: border-box;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid var(--mood-surface);
  
  flex-shrink: 0;
}

.user-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--mood-surface);
  
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 心动币余额 */
.balance {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 32rpx;
  padding: 12rpx 28rpx;
  
  width: fit-content;
  max-width: 100%;
  box-sizing: border-box;
}

.balance-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  flex-shrink: 0;
}

.coin-img {
  width: 32rpx;
  height: 32rpx;
  margin: 0 8rpx;
  flex-shrink: 0;
}

.balance-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--mood-surface);
}

.help-btn {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.help-btn:active {
  transform: scale(0.9);
}

.help-icon {
  font-size: 24rpx;
  color: var(--mood-surface);
  font-weight: bold;
  line-height: 1;
}

/* 通知按钮 */
.notification-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.notification-icon {
  width: 44rpx;
  height: 44rpx;
  
}

.notification-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 28rpx;
  height: 28rpx;
  background: var(--mood-rose);
  color: var(--mood-surface);
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  
  animation: badge-pulse 2s ease-in-out infinite;
}

@keyframes badge-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

/* 音乐按钮 */
.music-btn {
  position: absolute;
  top: 24rpx;
  right: 100rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.music-icon {
  width: 44rpx;
  height: 44rpx;
  
  transition: transform 0.3s ease;
}

.music-icon.playing {
  animation: rotate 3s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 未登录状态 */
.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  position: relative;
  z-index: 1;
  transition: transform 0.2s ease;
}

.login-card:active {
  transform: scale(0.98);
}

.login-text {
  font-size: 28rpx;
  color: var(--mood-surface);
  margin-top: 16rpx;
  font-weight: 500;
  text-align: center;
}

/* 功能列表区域 */
.menu-section {
  margin: 24rpx 32rpx;
  background: var(--mood-surface);
  border-radius: 20rpx;
  padding: 8rpx 0;
  
  box-sizing: border-box;
  overflow: hidden;
}

.menu-item {
  height: 112rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--mood-line);
  transition: background-color 0.2s ease;
  box-sizing: border-box;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--mood-paper);
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--mood-ink);
  font-weight: 500;
  margin-left: 20rpx;
}

.arrow {
  color: #D0C8C0;
  font-size: 28rpx;
  flex-shrink: 0;
}

/* 心动币说明弹窗 */
.coin-help-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.coin-help-content {
  width: 80%;
  background-color: var(--mood-surface);
  border-radius: 24rpx;
  overflow: hidden;
  
  box-sizing: border-box;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--mood-line);
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  color: var(--mood-ink);
  font-weight: 700;
}

.modal-close {
  font-size: 48rpx;
  color: var(--mood-faint);
  line-height: 1;
  padding: 0 8rpx;
  transition: transform 0.2s ease;
}

.modal-close:active {
  transform: scale(0.9);
}

.modal-body {
  padding: 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
  flex: 1;
}

.help-item {
  margin-bottom: 32rpx;
}

.help-item:last-child {
  margin-bottom: 0;
}

.help-question {
  font-size: 28rpx;
  color: var(--mood-sage);
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.help-answer {
  font-size: 26rpx;
  color: var(--mood-muted);
  line-height: 1.8;
  display: block;
  white-space: pre-line;
}

/* 音乐菜单弹窗 */
.music-menu-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.music-menu-content {
  width: 70%;
  background-color: var(--mood-surface);
  border-radius: 24rpx;
  overflow: hidden;
  
  box-sizing: border-box;
}

.music-menu-title {
  font-size: 32rpx;
  color: var(--mood-ink);
  font-weight: 700;
  text-align: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--mood-line);
}

.music-menu-list {
  padding: 8rpx 0;
}

.music-menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--mood-line);
  transition: background-color 0.2s ease;
}

.music-menu-item:last-child {
  border-bottom: none;
}

.music-menu-item:active {
  background: var(--mood-paper);
}

.music-menu-text {
  font-size: 30rpx;
  color: var(--mood-ink);
  font-weight: 500;
}

.music-menu-arrow {
  font-size: 36rpx;
  color: var(--mood-sage-soft);
  transition: transform 0.2s ease;
}

.music-singer-list {
  background-color: var(--mood-well);
  padding: 8rpx 0;
}

.music-singer-item {
  padding: 24rpx 32rpx 24rpx 64rpx;
  border-bottom: 1rpx solid var(--mood-line);
  transition: background-color 0.2s ease;
}

.music-singer-item:last-child {
  border-bottom: none;
}

.music-singer-item:active {
  background: var(--mood-paper);
}

.music-singer-text {
  font-size: 26rpx;
  color: var(--mood-muted);
}

/* 音乐播放栏 */
.music-player-bar {
  position: fixed;
  bottom: 120rpx;
  left: 32rpx;
  right: 32rpx;
  background: var(--mood-sage-soft);
  border-radius: 40rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  
  z-index: 999;
  box-sizing: border-box;
}

.music-player-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.music-player-name {
  font-size: 28rpx;
  color: var(--mood-surface);
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.music-player-singer {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

.music-player-controls {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.music-player-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
}

.music-player-btn:active {
  transform: scale(0.92);
}

.music-player-icon {
  font-size: 32rpx;
  color: var(--mood-surface);
}

/* 底部安全区域 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}



/* Page composition and touch geometry. */

.container { padding: 24rpx 32rpx 144rpx; }
.header { min-height: 272rpx; margin: 0 0 28rpx; background: var(--mood-sage-soft); border-radius: 36rpx; }
.header::before, .header::after { display: none; }
.user-card { padding: 84rpx 28rpx 36rpx; }
.avatar { width: 108rpx; height: 108rpx; border: 4rpx solid #FFFFFF; background: #FFFFFF; }
.nickname { color: var(--mood-ink); font-size: 36rpx; font-weight: 600; }
.balance { flex-wrap: wrap; padding: 0; margin-top: 14rpx; background: transparent; border-radius: 0; }
.balance-label { color: var(--mood-muted); font-size: 24rpx; }
.balance-text { color: var(--mood-sage-ink); font-size: 28rpx; font-weight: 500; }
.help-btn { width: 48rpx; height: 48rpx; background: #FFFFFF; }
.help-icon { color: var(--mood-sage); }
.notification-btn, .music-btn { width: 72rpx; height: 72rpx; top: 8rpx; }
.notification-btn { right: 12rpx; }
.music-btn { right: 92rpx; }
.notification-icon, .music-icon { width: 40rpx; height: 40rpx; }
.notification-badge { animation: none; top: 6rpx; right: 4rpx; min-width: 30rpx; height: 30rpx; font-size: 20rpx; }
.login-card { padding: 40rpx; }
.login-text { color: var(--mood-sage-ink); }
.menu-section { margin: 0 0 24rpx; border-radius: 32rpx; padding: 6rpx 28rpx; }
.menu-item { min-height: 112rpx; height: auto; padding: 24rpx 0; }
.menu-icon { width: 44rpx; height: 44rpx; margin-right: 24rpx; }
.menu-text { font-size: 28rpx; }
.arrow { color: var(--mood-muted); }
.coin-help-content { max-height: 82vh; overflow-y: auto; width: 88%; border-radius: 36rpx; }
.help-answer { font-size: 26rpx; line-height: 1.9; white-space: pre-line; }
.music-menu-content { border-radius: 36rpx 36rpx 0 0; padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); }
.music-player-bar { border: 1rpx solid var(--mood-line); border-radius: 24rpx; left: 32rpx; right: 32rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); background: #FFFFFF; box-shadow: 0 4rpx 20rpx rgba(41,60,51,.1); }

