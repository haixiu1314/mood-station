@import "../../styles/healing.wxss";
.container {
  padding: 24rpx 32rpx;
  padding-bottom: 120rpx;
  background-color: var(--mood-paper);
  min-height: 100vh;
  box-sizing: border-box;
}

.header-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: var(--mood-surface);
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  
  box-sizing: border-box;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: var(--mood-faint);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--mood-ink);
}

.search-btn {
  font-size: 28rpx;
  color: var(--mood-sage);
  font-weight: 600;
  margin-left: 12rpx;
}

.trash-btn {
  width: 80rpx;
  height: 80rpx;
  background-color: var(--mood-surface);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  
  transition: transform 0.2s ease;
  flex-shrink: 0;
}

.trash-btn:active {
  transform: scale(0.92);
}

.trash-icon {
  width: 36rpx;
  height: 36rpx;
}

.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.filter-btn {
  display: flex;
  align-items: center;
  background-color: var(--mood-surface);
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  
  transition: transform 0.2s ease;
}

.filter-btn:active {
  transform: scale(0.96);
}

.filter-btn.active {
  background: var(--mood-sage-soft);
}

.filter-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.filter-text {
  font-size: 26rpx;
  color: var(--mood-ink);
  font-weight: 500;
}

.filter-reset {
  font-size: 26rpx;
  color: var(--mood-sage);
  font-weight: 600;
  padding: 12rpx 24rpx;
}

.post-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.post-card {
  background-color: var(--mood-surface);
  border-radius: 20rpx;
  padding: 28rpx;
  
  transition: transform 0.2s ease;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  animation: none;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.post-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--mood-sage-soft);
  border-radius: 2rpx;
}

.post-card:active {
  transform: scale(0.98);
  
}

.post-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.emotion-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.emotion-icon {
  margin-right: 6rpx;
  font-size: 28rpx;
}

.emotion-tag.happy {
  background-color: var(--mood-honey-soft);
  color: var(--mood-honey);
}

.emotion-tag.sad {
  background-color: var(--mood-blue-soft);
  color: var(--mood-blue);
}

.emotion-tag.angry {
  background-color: var(--mood-rose-soft);
  color: var(--mood-rose);
}

.emotion-tag.calm {
  background-color: var(--mood-sage-soft);
  color: var(--mood-sage-ink);
}

.post-time {
  font-size: 24rpx;
  color: var(--mood-faint);
}

.post-title {
  font-size: 32rpx;
  color: var(--mood-ink);
  font-weight: 700;
  margin-bottom: 16rpx;
}

.post-content {
  font-size: 28rpx;
  color: var(--mood-muted);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.post-stats {
  display: flex;
  gap: 24rpx;
}

.stat-item {
  font-size: 24rpx;
  color: var(--mood-faint);
}

.delete-btn {
  font-size: 24rpx;
  color: var(--mood-rose);
  padding: 8rpx 16rpx;
  background-color: var(--mood-rose-soft);
  border-radius: 16rpx;
  transition: transform 0.2s ease;
  font-weight: 500;
}

.delete-btn:active {
  transform: scale(0.96);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  color: var(--mood-sage-soft);
}

.empty-text {
  font-size: 28rpx;
  color: var(--mood-faint);
  font-weight: 500;
}



/* Page composition and touch geometry. */

.container { min-height: 100vh; }
.header-bar { gap: 16rpx; margin-bottom: 24rpx; }
.search-bar { min-height: 88rpx; background: #FFFFFF; border: 0; border-radius: 999rpx; }
.search-input { color: var(--mood-ink); min-width: 0; }
.trash-btn { width: 88rpx; height: 88rpx; border-radius: 50%; background: var(--mood-well); }
.filter-btn { min-height: 80rpx; border: 0; border-radius: 999rpx; background: var(--mood-well); }
.filter-btn.active { background: var(--mood-sage-soft); color: var(--mood-sage-ink); }
.diary-card, .post-card, .trash-card { padding: 28rpx; border-radius: 32rpx; margin-bottom: 24rpx; }
.diary-card::before, .post-card::before { display: none; }
.diary-header, .post-header, .trash-header { gap: 12rpx; flex-wrap: wrap; }
.diary-title, .post-title, .trash-title { color: var(--mood-ink); font-size: 30rpx; font-weight: 600; line-height: 1.7; }
.diary-content, .post-content, .trash-content { color: var(--mood-muted); font-size: 28rpx; line-height: 1.85; }
.diary-footer, .post-footer, .trash-footer { border-top-width: 1rpx; }
.delete-btn, .more-btn { min-height: 72rpx; min-width: 88rpx; display: flex; align-items: center; justify-content: center; }
.trash-tip { border-radius: 24rpx; background: var(--mood-honey-soft); color: var(--mood-honey); padding: 24rpx; }
.tip-text, .expire-text { color: var(--mood-honey); font-size: 24rpx; }
.action-content, .action-popup { border-radius: 36rpx 36rpx 0 0; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.action-item { min-height: 100rpx; }

