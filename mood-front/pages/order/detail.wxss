@import "../../styles/healing.wxss";
.container {
  padding: 24rpx 32rpx;
  padding-bottom: 120rpx;
  background-color: var(--mood-paper);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 状态区域 */
.status-section {
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
  background: var(--mood-sage-soft);
  border-radius: 20rpx;
  
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.status-section::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
}

.status-section::after {
  content: '';
  position: absolute;
  bottom: 30rpx;
  left: 30rpx;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.status {
  font-size: 40rpx;
  color: var(--mood-surface);
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
  
}

.status.pending {
  color: var(--mood-surface);
}

.order-no {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  position: relative;
  z-index: 1;
}

/* 商品区域 */
.products-section {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background-color: var(--mood-surface);
  border-radius: 20rpx;
  
  box-sizing: border-box;
  animation: none;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.section-title {
  font-size: 32rpx;
  color: var(--mood-ink);
  font-weight: 600;
  display: block;
  margin-bottom: 24rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: var(--mood-sage-soft);
  border-radius: 3rpx;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--mood-line);
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background-color: var(--mood-well);
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 28rpx;
  color: var(--mood-ink);
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.product-spec {
  font-size: 24rpx;
  color: var(--mood-muted);
  display: inline-block;
  padding: 4rpx 12rpx;
  background-color: var(--mood-paper);
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.product-detail {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quantity {
  font-size: 24rpx;
  color: var(--mood-muted);
}

.price {
  display: flex;
  align-items: center;
}

.coin-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.price text {
  font-size: 30rpx;
  color: var(--mood-sage);
  font-weight: 700;
}

/* 订单汇总 */
.summary {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background-color: var(--mood-surface);
  border-radius: 20rpx;
  
  box-sizing: border-box;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.summary-row .label {
  font-size: 28rpx;
  color: var(--mood-muted);
}

.summary-row .value {
  display: flex;
  align-items: center;
}

.summary-row .amount {
  font-size: 28rpx;
  color: var(--mood-ink);
  font-weight: 500;
}

.summary-row.total {
  padding-top: 20rpx;
  margin-top: 12rpx;
  border-top: 2rpx solid var(--mood-line);
}

.summary-row.total .label {
  font-size: 30rpx;
  color: var(--mood-ink);
  font-weight: 600;
}

.summary-row.total .amount {
  font-size: 40rpx;
  color: var(--mood-sage);
  font-weight: 700;
}

/* 订单信息 */
.info {
  padding: 28rpx;
  background-color: var(--mood-surface);
  border-radius: 20rpx;
  
  box-sizing: border-box;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--mood-line);
}

.info-row:last-child {
  border-bottom: none;
}

.info-row .label {
  font-size: 28rpx;
  color: var(--mood-muted);
}

.info-row .value {
  font-size: 28rpx;
  color: var(--mood-ink);
  font-weight: 500;
  text-align: right;
  max-width: 60%;
}

/* 操作按钮区域 */
.action-section {
  margin-top: 32rpx;
  padding: 0 0 120rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 20rpx;
}

.action-section button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  margin: 0;
  padding: 0;
  border: none;
  transition: transform 0.2s ease;
}

.action-section button::after {
  border: none;
}

.action-section button:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.btn-cancel {
  background-color: var(--mood-paper);
  color: var(--mood-sage);
  border: 2rpx solid var(--mood-sage-soft) !important;
}

.btn-refund {
  background: var(--mood-sage-soft);
  color: #fff;
  
}

.btn-confirm {
  background: var(--mood-sage-soft);
  color: var(--mood-surface);
  
}

/* 退款状态 */
.refund-status-wrap {
  width: 100%;
  text-align: center;
  padding: 16rpx 0;
}

.refund-status {
  font-size: 26rpx;
  color: var(--mood-honey);
  padding: 8rpx 20rpx;
  background-color: var(--mood-honey-soft);
  border-radius: 24rpx;
  display: inline-block;
  font-weight: 500;
}

.refund-status.rejected {
  color: var(--mood-rose);
  background-color: var(--mood-rose-soft);
}



/* Page composition and touch geometry. */

.container { padding-top: 24rpx; }
.status-section { background: var(--mood-sage-soft); text-align: left; padding: 36rpx; border-radius: 32rpx; }
.status-section::before, .status-section::after { display: none; }
.status-section .detail-kicker { color: var(--mood-muted); margin-bottom: 12rpx; }
.status, .status.pending { color: var(--mood-sage-ink); font-size: 42rpx; font-weight: 600; }
.order-no { color: var(--mood-muted); font-size: 24rpx; overflow-wrap: anywhere; }
.info-row { align-items: flex-start; gap: 24rpx; border-bottom-width: 1rpx; padding: 24rpx 0; }
.info-row .label { flex-shrink: 0; }
.info-row .value { max-width: 68%; line-height: 1.8; overflow-wrap: anywhere; }
.summary-row .amount { color: var(--mood-sage-ink); font-size: 36rpx; font-weight: 600; }
.action-section { flex-wrap: wrap; padding: 0; }
.action-section button { min-width: 200rpx; }

