<wxs module="media" src="../../utils/media.wxs" />
<view class="container mood-page mood-order-confirm">
  <view class="screen-heading"><text class="screen-title">确认这份心意</text><text class="screen-subtitle">核对商品和地址，让喜欢顺利抵达。</text></view>
  <view class="address-section card" bindtap="onChooseAddress" hover-class="mood-pressed" hover-start-time="20" hover-stay-time="90">
    <view class="address-info" wx:if="{{address}}">
      <view class="address-header">
        <text class="name">{{address.name}}</text>
        <text class="phone">{{address.phone}}</text>
        <text class="default-tag" wx:if="{{address.isDefault === 1}}">默认</text>
      </view>
      <text class="address-detail">{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</text>
    </view>
    <view class="no-address" wx:else>
      <text>请选择收货地址</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="order-section card">
    <text class="section-title">订单商品</text>
    <view class="order-item" wx:for="{{orderItems}}" wx:key="id">
      <image class="item-image" src="{{media.src(item.productImage)}}" mode="aspectFill"></image>
      <view class="item-info">
        <text class="item-name">{{item.productName}}</text>
        <text class="item-spec" wx:if="{{item.selectedSpec}}">{{item.selectedSpec}}</text>
        <view class="item-detail">
          <text class="quantity">x{{item.quantity}}</text>
          <view class="price">
            <image class="coin-icon" src="/images/healing/coin.png" mode="aspectFit"></image>
            <text>{{item.price}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="summary card">
    <view class="summary-row">
      <text class="label">商品合计</text>
      <view class="value">
        <image class="coin-icon" src="/images/healing/coin.png" mode="aspectFit"></image>
        <text>{{totalAmount}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="total-section">
      <text class="total-label">实付:</text>
      <view class="total-amount">
        <image class="coin-icon" src="/images/healing/coin.png" mode="aspectFit"></image>
        <text class="amount">{{totalAmount}}</text>
      </view>
    </view>
    <button class="btn-submit" bindtap="onSubmitOrder" hover-class="mood-pressed" hover-start-time="20" hover-stay-time="90">提交订单</button>
  </view>
</view>
