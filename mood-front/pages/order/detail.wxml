<wxs module="media" src="../../utils/media.wxs" />
<view class="container mood-page mood-order-detail" wx:if="{{order}}">
  <view class="status-section card">
    <text class="detail-kicker">订单进度</text>
    <text class="status">{{order.statusText}}</text>
    <text class="order-no">订单号: {{order.orderNo}}</text>
  </view>

  <view class="products-section card">
    <text class="section-title">商品列表</text>
    <view class="product-item" wx:for="{{order.items}}" wx:key="id">
      <image class="product-image" src="{{media.src(item.productImage)}}" mode="aspectFill"></image>
      <view class="product-info">
        <text class="product-name">{{item.productName}}</text>
        <text class="product-spec" wx:if="{{item.selectedSpec}}">{{item.selectedSpec}}</text>
        <view class="product-detail">
          <text class="quantity">x{{item.quantity}}</text>
          <view class="price">
            <image class="coin-icon" src="/images/healing/coin.png" mode="aspectFit"></image>
            <text>{{item.price}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="summary card">
    <view class="summary-row">
      <text class="label">订单总额</text>
      <view class="value">
        <image class="coin-icon" src="/images/healing/coin.png" mode="aspectFit"></image>
        <text class="amount">{{order.totalAmount}}</text>
      </view>
    </view>
  </view>

  <view class="info card">
    <view class="info-row">
      <text class="label">下单时间</text>
      <text class="value">{{order.createTime}}</text>
    </view>
    <view class="info-row" wx:if="{{order.addressName}}">
      <text class="label">收货人</text>
      <text class="value">{{order.addressName}} {{order.addressPhone}}</text>
    </view>
    <view class="info-row" wx:if="{{order.addressDetail}}">
      <text class="label">收货地址</text>
      <text class="value">{{order.addressDetail}}</text>
    </view>
    <!-- 发货人信息（已发货时显示） -->
    <view class="info-row" wx:if="{{order.senderName}}">
      <text class="label">发货人</text>
      <text class="value">{{order.senderName}} {{order.senderPhone}}</text>
    </view>
    <view class="info-row" wx:if="{{order.senderAddress}}">
      <text class="label">发货地址</text>
      <text class="value">{{order.senderAddress}}</text>
    </view>
  </view>

  <!-- 操作按钮区域 -->
  <view class="action-section">
    <!-- 待发货：取消订单 -->
    <button class="btn-cancel" wx:if="{{order.status === 'pending'}}" bindtap="onCancelOrder" hover-class="mood-pressed" hover-start-time="20" hover-stay-time="90">取消订单</button>
    
    <!-- 已发货：申请退款 -->
    <button class="btn-refund" wx:if="{{order.status === 'shipped' && order.refundStatus !== 0}}" bindtap="onApplyRefund" hover-class="mood-pressed" hover-start-time="20" hover-stay-time="90">申请退款</button>
    <view class="refund-status-wrap" wx:if="{{order.refundStatus === 0}}">
      <text class="refund-status">退款审核中...</text>
    </view>
    
    <!-- 已签收且未完成：确认收货 -->
    <button class="btn-confirm" wx:if="{{order.expressStatus === 'signed' && order.status !== 'completed'}}" bindtap="onConfirmReceived" hover-class="mood-pressed" hover-start-time="20" hover-stay-time="90">确认收货</button>
  </view>
</view>
