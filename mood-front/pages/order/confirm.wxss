@import "../../styles/healing.wxss";
.container {
  padding: 24rpx 32rpx;
  padding-bottom: 200rpx;
  background-color: var(--mood-paper);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 地址区域 */
.address-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  margin-bottom: 24rpx;
  background-color: var(--mood-surface);
  border-radius: 20rpx;
  
  transition: transform 0.2s ease;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.address-section::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  width: 6rpx;
  height: 60%;
  background: var(--mood-sage-soft);
  border-radius: 3rpx;
}

.address-section:active {
  transform: scale(0.98);
  
}

.address-info {
  flex: 1;
  padding-left: 16rpx;
  min-width: 0;
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.address-header .name {
  font-size: 32rpx;
  color: var(--mood-ink);
  font-weight: 600;
  margin-right: 24rpx;
}

.address-header .phone {
  font-size: 28rpx;
  color: var(--mood-muted);
}

.address-detail {
  font-size: 28rpx;
  color: var(--mood-ink);
  line-height: 1.6;
}

.no-address {
  font-size: 28rpx;
  color: var(--mood-faint);
  padding-left: 16rpx;
}

.arrow {
  font-size: 36rpx;
  color: #D0C8C0;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 订单商品区域 */
.order-section {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background-color: var(--mood-surface);
  border-radius: 20rpx;
  
  box-sizing: border-box;
  animation: none;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.section-title {
  font-size: 32rpx;
  color: var(--mood-ink);
  font-weight: 600;
  display: block;
  margin-bottom: 24rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: var(--mood-sage-soft);
  border-radius: 3rpx;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--mood-line);
}

.order-item:last-child {
  border-bottom: none;
}

.item-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background-color: var(--mood-well);
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  color: var(--mood-ink);
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.item-spec {
  font-size: 24rpx;
  color: var(--mood-muted);
  display: inline-block;
  padding: 4rpx 12rpx;
  background-color: var(--mood-paper);
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.item-detail {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quantity {
  font-size: 24rpx;
  color: var(--mood-muted);
}

.price {
  display: flex;
  align-items: center;
}

.coin-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.price text {
  font-size: 30rpx;
  color: var(--mood-sage);
  font-weight: 700;
}

/* 订单汇总 */
.summary {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background-color: var(--mood-surface);
  border-radius: 20rpx;
  
  box-sizing: border-box;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.summary-row .label {
  font-size: 28rpx;
  color: var(--mood-muted);
}

.summary-row .value {
  display: flex;
  align-items: center;
}

.summary-row .value text {
  font-size: 28rpx;
  color: var(--mood-ink);
  font-weight: 500;
}

.summary-row.total {
  padding-top: 20rpx;
  margin-top: 12rpx;
  border-top: 2rpx solid var(--mood-line);
}

.summary-row.total .label {
  font-size: 30rpx;
  color: var(--mood-ink);
  font-weight: 600;
}

.summary-row.total .value text {
  font-size: 40rpx;
  color: var(--mood-sage);
  font-weight: 700;
}

/* 底部提交栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: var(--mood-surface);
  
  z-index: 100;
  box-sizing: border-box;
}

.total-section {
  display: flex;
  align-items: center;
}

.total-label {
  font-size: 28rpx;
  color: var(--mood-ink);
  margin-right: 12rpx;
  font-weight: 500;
}

.total-amount {
  display: flex;
  align-items: center;
}

.total-amount .amount {
  font-size: 40rpx;
  color: var(--mood-sage);
  font-weight: 700;
}

.btn-submit {
  background: var(--mood-sage-soft);
  color: var(--mood-surface);
  border-radius: 40rpx;
  padding: 20rpx 56rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  
  transition: transform 0.2s ease;
}

.btn-submit::after {
  border: none;
}

.btn-submit:active {
  transform: scale(0.96);
  opacity: 0.9;
}



/* Page composition and touch geometry. */

.order-item, .order-section, .summary, .address-section { border-radius: 32rpx; }
.order-item::before, .address-section::before { display: none; }
.order-no { font-size: 24rpx; color: var(--mood-muted); overflow-wrap: anywhere; }
.order-header { gap: 20rpx; }
.product-name, .item-name { font-size: 28rpx; line-height: 1.7; }
.product-spec, .item-spec { color: var(--mood-muted); }
.status { color: var(--mood-sage-ink); font-size: 26rpx; white-space: nowrap; }
.express-info { background: var(--mood-well); border-radius: 20rpx; padding: 24rpx; }
.express-status, .express-detail { color: var(--mood-muted); line-height: 1.8; }

.container { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.address-section { background: var(--mood-sage-soft); }
.address-detail { font-size: 28rpx; line-height: 1.8; }
.btn-submit { min-width: 256rpx; }

