@import "../../styles/healing.wxss";
.container {
  padding: 24rpx 32rpx;
  padding-bottom: 200rpx;
  background-color: var(--mood-paper);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 购物车项 */
.cart-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background-color: var(--mood-surface);
  border-radius: 20rpx;
  
  transition: transform 0.2s ease;
  box-sizing: border-box;
  animation: none;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.cart-item:active {
  transform: scale(0.98);
  
}

.item-select {
  margin-right: 20rpx;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid var(--mood-sage-soft);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--mood-surface);
  transition: transform 0.2s ease;
}

.checkbox.checked {
  background: var(--mood-sage-soft);
  border-color: var(--mood-sage-soft);
  
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background-color: var(--mood-well);
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 160rpx;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  color: var(--mood-ink);
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.item-spec {
  font-size: 24rpx;
  color: var(--mood-muted);
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  background-color: var(--mood-paper);
  border-radius: 12rpx;
  display: inline-block;
  width: fit-content;
}

.item-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price {
  display: flex;
  align-items: center;
}

.coin-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.price text {
  font-size: 32rpx;
  color: var(--mood-sage);
  font-weight: 700;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.quantity-control .btn {
  width: 52rpx;
  height: 52rpx;
  background-color: var(--mood-paper);
  border: 2rpx solid var(--mood-sage-soft);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--mood-sage);
  transition: transform 0.2s ease;
}

.quantity-control .btn:active {
  transform: scale(0.9);
  background-color: var(--mood-sage-soft);
}

.quantity-control .quantity {
  margin: 0 16rpx;
  font-size: 30rpx;
  color: var(--mood-ink);
  min-width: 48rpx;
  text-align: center;
  font-weight: 600;
}

.item-remove {
  width: 48rpx;
  height: 48rpx;
  background: var(--mood-sage-soft);
  color: var(--mood-surface);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-left: 20rpx;
  transition: transform 0.2s ease;
  
  flex-shrink: 0;
}

.item-remove:active {
  transform: scale(0.9);
}

/* 底部结算栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: var(--mood-surface);
  
  z-index: 100;
  box-sizing: border-box;
}

.action-left {
  flex-shrink: 0;
}

.btn-clear {
  padding: 16rpx 32rpx;
  background: var(--mood-sage-soft);
  border-radius: 40rpx;
  border: 2rpx solid #FFD0D0;
  
  transition: transform 0.2s ease;
}

.btn-clear text {
  font-size: 26rpx;
  color: var(--mood-rose);
  font-weight: 600;
}

.btn-clear:active {
  transform: scale(0.96);
}

.action-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.total-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.total-label {
  font-size: 26rpx;
  color: var(--mood-muted);
}

.total-amount {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.total-amount .coin-icon {
  width: 28rpx;
  height: 28rpx;
}

.total-amount .amount {
  font-size: 36rpx;
  color: var(--mood-sage);
  font-weight: 700;
}

.btn-checkout {
  padding: 16rpx 48rpx;
  background: var(--mood-sage-soft);
  color: var(--mood-surface);
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  
  transition: transform 0.2s ease;
  white-space: nowrap;
}

.btn-checkout::after {
  border: none;
}

.btn-checkout:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* 空购物车 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-cart image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-cart text {
  font-size: 28rpx;
  color: var(--mood-faint);
}



/* Page composition and touch geometry. */

.container { padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.cart-item { position: relative; padding: 28rpx 24rpx; gap: 16rpx; align-items: flex-start; }
.item-select { padding: 12rpx 0; margin: 0; min-width: 48rpx; }
.checkbox { width: 44rpx; height: 44rpx; border: 2rpx solid var(--mood-control); }
.checkbox.checked { background: var(--mood-sage); border-color: var(--mood-sage); color: #FFFFFF; }
.item-image { width: 136rpx; height: 156rpx; margin-right: 0; border-radius: 20rpx; }
.item-info { height: auto; min-height: 156rpx; padding-right: 20rpx; }
.item-name { padding-right: 24rpx; font-size: 28rpx; line-height: 1.6; }
.item-price-row { flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.quantity-control .btn { width: 64rpx; height: 64rpx; border: 0; border-radius: 20rpx; background: var(--mood-well); }
.quantity-control .quantity { min-width: 32rpx; margin: 0 12rpx; }
.item-remove { position: absolute; right: 12rpx; top: 8rpx; margin: 0; width: 56rpx; height: 56rpx; color: var(--mood-muted); background: transparent; }
.btn-clear { background: transparent; border: 0; padding: 16rpx 12rpx; min-height: 80rpx; }
.action-right { flex: 1; justify-content: flex-end; gap: 20rpx; min-width: 0; }
.total-label { font-size: 24rpx; }
.total-amount .amount { font-size: 34rpx; }
.btn-checkout { min-width: 180rpx; margin: 0; }


/* Explicit geometry avoids the native button line-height shifting its label. */
.mood-shop-cart .bottom-bar { align-items: center; gap: 20rpx; }
.mood-shop-cart .btn-clear { min-width: 104rpx; min-height: 88rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #E4BFC3; background: var(--mood-rose-soft); border-radius: 24rpx; box-sizing: border-box; }
.mood-shop-cart .btn-clear text { color: var(--mood-rose); font-weight: 600; line-height: 1.4; }
.mood-shop-cart .action-right { gap: 20rpx; }
.mood-shop-cart .total-info { flex: 1; min-width: 0; flex-wrap: wrap; justify-content: flex-end; gap: 2rpx 8rpx; }
.mood-shop-cart .total-amount { min-width: 0; }
.mood-shop-cart .total-amount .amount { font-size: 32rpx; overflow-wrap: anywhere; }
.mood-shop-cart .btn-checkout { flex: 0 0 180rpx; width: 180rpx; min-width: 180rpx; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; line-height: 1; text-align: center; box-sizing: border-box; }
