/* 情绪小站：暖白纸面、鼠尾草绿、清晰的文字层级。 */
page {
  --mood-paper: #F7F8F2;
  --mood-surface: #FFFFFF;
  --mood-well: #F0F3EC;
  --mood-sage-soft: #E5EEE4;
  --mood-sage: #476B55;
  --mood-sage-ink: #355440;
  --mood-ink: #293C33;
  --mood-muted: #5D6D63;
  --mood-faint: #68756A;
  --mood-line: #E3E8DE;
  --mood-control: #BCC9B9;
  --mood-rose: #934C56;
  --mood-rose-soft: #F8EBEB;
  --mood-honey: #795D26;
  --mood-honey-soft: #F5EEDC;
  --mood-blue: #4B6784;
  --mood-blue-soft: #EAF0F6;
  --mood-radius: 32rpx;
  --mood-ease: cubic-bezier(0.22, 0.68, 0, 1);
  background: var(--mood-paper);
  color: var(--mood-ink);
  font-family: 'PingFang SC', 'Microsoft YaHei', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-text-size-adjust: 100%;
}
view, scroll-view, swiper, input, textarea, button { box-sizing: border-box; }
button { font-family: inherit; font-size: 28rpx; font-weight: 600; }
button::after { border: 0; }
button[disabled] { opacity: 1; color: var(--mood-muted); background: var(--mood-well); }
.container { padding: 32rpx; }
.card { background: var(--mood-surface); border-radius: var(--mood-radius); padding: 32rpx; margin-bottom: 24rpx; }
.ui-icon { width: 40rpx; height: 40rpx; flex-shrink: 0; vertical-align: middle; }
.btn-primary { background: var(--mood-sage); color: #FFFFFF; border-radius: 999rpx; padding: 22rpx 40rpx; }
.btn-secondary, .btn-outline { background: var(--mood-sage-soft); color: var(--mood-sage-ink); border-radius: 999rpx; padding: 22rpx 40rpx; }
.btn-danger { background: var(--mood-rose-soft); color: var(--mood-rose); border-radius: 999rpx; padding: 22rpx 40rpx; }
.text-muted { color: var(--mood-muted); font-size: 24rpx; }
.text-primary { color: var(--mood-sage); }
.text-warm { color: var(--mood-honey); }
.text-danger { color: var(--mood-rose); }
.tag { display: inline-block; font-size: 22rpx; line-height: 1.5; padding: 6rpx 14rpx; border-radius: 12rpx; background: var(--mood-well); color: var(--mood-muted); }
.tag-healing { background: var(--mood-sage-soft); color: var(--mood-sage-ink); }
.tag-hot { background: var(--mood-rose-soft); color: var(--mood-rose); }
.tag-warm { background: var(--mood-honey-soft); color: var(--mood-honey); }
.input { background: var(--mood-well); color: var(--mood-ink); border: 2rpx solid transparent; border-radius: 20rpx; padding: 24rpx; font-size: 28rpx; }
.input:focus { border-color: var(--mood-sage); background: var(--mood-surface); }
.section-title { display: block; color: var(--mood-ink); font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx; }
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 88rpx 32rpx; color: var(--mood-muted); text-align: center; line-height: 1.8; }
.empty-state text { color: var(--mood-muted); font-size: 26rpx; }
.empty-state image { width: 112rpx; height: 112rpx; margin-bottom: 24rpx; }
.loading { display: flex; justify-content: center; padding: 40rpx; color: var(--mood-muted); }
.loading-spinner { width: 40rpx; height: 40rpx; border: 3rpx solid var(--mood-line); border-top-color: var(--mood-sage); border-radius: 50%; animation: mood-spin 900ms linear infinite; }
.divider { height: 1rpx; background: var(--mood-line); margin: 24rpx 0; }
.modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; background: rgba(25, 43, 33, .36); }
.modal-content { width: 86%; background: var(--mood-surface); border-radius: 36rpx; overflow: hidden; }
.modal-header { display: flex; align-items: center; justify-content: space-between; padding: 32rpx; }
.modal-title { color: var(--mood-ink); font-size: 32rpx; font-weight: 600; }
.modal-body { padding: 0 32rpx 32rpx; color: var(--mood-muted); line-height: 1.8; }
.modal-footer { display: flex; gap: 20rpx; padding: 24rpx 32rpx 32rpx; }
.modal-btn { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 999rpx; }
.modal-btn-cancel { color: var(--mood-muted); background: var(--mood-well); }
.modal-btn-confirm { color: #FFFFFF; background: var(--mood-sage); }
@keyframes mood-spin { to { transform: rotate(360deg); } }
@keyframes mood-reveal { from { opacity: .35; transform: translateY(8rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes mood-sheet { from { opacity: .4; transform: translateY(24rpx); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) {
  .loading-spinner { animation: none; }
}
