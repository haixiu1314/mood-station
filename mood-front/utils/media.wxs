function src(value) {
  if (!value || typeof value !== 'string') return '';
  var path = value;
  if (value.indexOf('http://localhost:') === 0 || value.indexOf('https://localhost:') === 0 || value.indexOf('http://127.0.0.1:') === 0 || value.indexOf('https://127.0.0.1:') === 0) {
    var start = value.indexOf('/uploads/');
    if (start < 0) return value;
    path = value.slice(start);
  } else if (value.indexOf('/uploads/') !== 0) {
    return value;
  }
  path = path.split('?')[0].split('#')[0];
  return localImages[path] || localAvatars[path] || value;
}
