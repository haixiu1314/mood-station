<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moodlater.mapper.LikeRecordMapper">

    <insert id="insert" parameterType="com.moodlater.entity.LikeRecord" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO like_record (user_id, post_id)
        VALUES (#{userId}, #{postId})
    </insert>

    <delete id="deleteByUserIdAndPostId">
        DELETE FROM like_record WHERE user_id = #{userId} AND post_id = #{postId}
    </delete>

    <select id="selectByUserIdAndPostId" resultType="com.moodlater.entity.LikeRecord">
        SELECT id, user_id, post_id, create_time
        FROM like_record
        WHERE user_id = #{userId} AND post_id = #{postId}
    </select>

</mapper>
