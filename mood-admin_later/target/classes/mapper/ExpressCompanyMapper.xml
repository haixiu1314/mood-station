<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moodlater.mapper.ExpressCompanyMapper">

    <select id="selectAll" resultType="com.moodlater.entity.ExpressCompany">
        SELECT id, name, code, placeholder, sort_order as sortOrder
        FROM express_company
        ORDER BY sort_order ASC
    </select>

</mapper>
